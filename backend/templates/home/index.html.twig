{% extends 'base.html.twig' %}

{% block title %}CatFun{% endblock %}

{% block body %}
    <h1>CatFun 🐱</h1>
    {% if app.user %}
        <p>Connecté en tant que {{ app.user.pseudo }} — <a href="{{ path('app_logout') }}">Déconnexion</a></p>
    {% else %}
        <p><a href="{{ path('app_login') }}">Connexion</a> · <a href="{{ frontend_url }}/#/register">Inscription</a></p>
    {% endif %}
{% endblock %}
