{
  "compilerOptions": {
    // --- Cible : navigateurs récents (Vite fait le bundle) ---
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "moduleResolution": "bundler",
    "types": ["vite/client"],

    // --- TypeScript ne fait que vérifier les types, Vite génère le JS ---
    "noEmit": true,
    "isolatedModules": true,

    // --- Vérifications ---
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"]
}
